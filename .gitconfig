[include]
	path = ~/.gitconfig.local
[core]
	excludesfile = ~/.gitignore_global
  editor = nvim
	fsmonitor = true
	untrackedCache = true
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path =

[merge]
  tool = nvimdiff
  ; tool = diffconflicts
[mergetool "nvimdiff"]
	cmd = nvim -d $LOCAL $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'
[mergetool "diffconflicts"]
  cmd = nvim -c DiffConflicts "$MERGED" "$BASE" "$LOCAL" "$REMOTE"
  trustExitCode = true
[diff]
  tool = nvimdiff
  ; tool = diffconflicts
[user]
	name = Tung Tram
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
#[commit]
#	template = /Users/tungtram/.stCommitMsg
#[credential]
#	helper = osxkeychain
[url "git@github.com:"]
	insteadOf = https://github.com/

[alias]
	current = rev-parse --abbrev-ref HEAD
	recent = !git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/heads/ | head -n 100
	fco= !BRANCH=`git recent | fzf` && git checkout ${BRANCH}
  freset= !BRANCH=`git recent | fzf` && git checkout ${BRANCH} && git fetch origin && git reset --hard FETCH_HEAD
	fmerge= !BRANCH=`git recent | fzf` && git merge ${BRANCH}
[mergetool]
	keepBackup = false
[pull]
	rebase = false
[trace2]
	eventNesting = 0
