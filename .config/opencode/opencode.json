{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "bundle *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "pwd *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "tail *": "allow",
      "head *": "allow",
      "sort *": "allow",
      "which *": "allow",
      "glab auth *": "allow",
      "glab mr *": "allow",
      "echo *": "allow",
      "test *": "allow"
    }
  },
  "command": {
    "mr": {
      "template": "Create a merge request using glab for current branch, with a proper title and description based on the git commit history.",
      "description": "Create MR using glab for current branch"
    },
    "pr": {
      "template": "Create a pull request using gh for current branch, with a proper title and description based on the git commit history and follow the template.",
      "description": "Create PR using gh for current branch"
    }
  },
  "plugin": [
    "./plugins/caveman/plugin.js",
    "@dietrichgebert/ponytail",
    "oh-my-openagent@latest"
  ],
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/deepseek",
      "options": {},
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek Flash"
        }
      }
    },
